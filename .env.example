PORT=8787
# Leave empty for a same-origin deploy (Vercel) so the frontend uses relative
# /api paths. Set to the API origin only when the API is hosted separately.
VITE_API_BASE_URL=
# The deployed public origin, including scheme. Required so the browser origin
# is accepted by the API's allow-list, e.g. https://your-app.vercel.app
PUBLIC_BASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Set true to try public RPC reads when no chain-specific RPC URL is configured.
# For production and hackathon judging, use dedicated RPC URLs for reliability.
ENABLE_PUBLIC_RPC_READS=false

# Optional RPC overrides. When omitted, live RPC fields are reported as unavailable.
XLAYER_RPC_URL=
ETHEREUM_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
POLYGON_RPC_URL=
BNB_RPC_URL=
OPTIMISM_RPC_URL=

# Optional explorer/API keys for future deep scans.
ETHERSCAN_API_KEY=
OKLINK_API_KEY=

# Launch the OKX.AI A2MCP service as free unless verified payment middleware is connected.
# demo: premium endpoints are callable but settlementVerified is always false.
# enforce: premium endpoints require verified settlement before executing.
OKX_SENTINEL_PAYMENT_MODE=demo
# Receiving wallet/address that settlement must pay to (your ASP wallet).
OKX_SENTINEL_PAYMENT_RECIPIENT=

# How settlement is verified when PAYMENT_MODE=enforce. One of:
#   trusted-proxy    : an upstream OKX Payment SDK/x402 proxy strips inbound
#                      X-OKX-Payment-Verified and sets it after verifying.
#   x402-facilitator : this service calls an x402 facilitator to verify+settle
#                      the caller's X-PAYMENT header itself (see vars below).
# Leave empty to keep premium endpoints unverifiable (no revenue counted).
OKX_SENTINEL_PAYMENT_VERIFICATION=

# --- x402-facilitator mode settings (only used when VERIFICATION=x402-facilitator) ---
# Facilitator base URL exposing POST /verify and POST /settle (OKX Payment SDK
# facilitator or any x402-compatible facilitator).
OKX_SENTINEL_X402_FACILITATOR_URL=
OKX_SENTINEL_X402_FACILITATOR_API_KEY=
# Settlement asset details. Amounts are computed in the asset's smallest unit.
OKX_SENTINEL_PAYMENT_NETWORK=x-layer
OKX_SENTINEL_PAYMENT_ASSET=
OKX_SENTINEL_PAYMENT_ASSET_DECIMALS=6
OKX_SENTINEL_X402_SCHEME=exact
OKX_SENTINEL_X402_TIMEOUT_SECONDS=60
OKX_SENTINEL_X402_TIMEOUT_MS=8000

# Optional newline-delimited JSON telemetry persistence.
# Use a writable absolute path in production, for example /var/log/okx-sentinel/events.ndjson.
OKX_SENTINEL_TELEMETRY_FILE=
